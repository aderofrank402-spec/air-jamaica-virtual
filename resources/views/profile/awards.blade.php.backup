.bg-jamaica-green { background-color: #009639 !important; }

.milestone-card {
    background: linear-gradient(135deg, rgba(255,215,0,0.1), rgba(0,150,57,0.1));
    padding: 1.5rem;
    border-radius: 10px;
    text-align: center;
    border: 1px solid rgba(255,215,0,0.3);
}

.award-card {
    border: 1px solid #e3f2fd;
    transition: all 0.3s ease;
    background: linear-gradient(135deg, rgba(255,255,255,0.95) 0%, rgba(248,249,250,0.95) 100%);
}

.award-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 8px 25px rgba(0,0,0,0.1);
    border-color: #FFD700;
}

.award-icon {
    height: 80px;
    display: flex;
    align-items: center;
    justify-content: center;
}

.award-image {
    max-width: 60px;
    max-height: 60px;
    object-fit: contain;
}

.jamaica-gold { color: #FFD700 !important; }
.jamaica-green { color: #009639 !important; }

.award-meta .badge {
    font-size: 0.75rem;
    margin: 0 0.25rem;
}

.badge-success {
    background-color: #009639;
    color: white;
}

.badge-primary {
    background-color: #0066CC;
    color: white;
}

.no-awards-state {
    padding: 3rem 1rem;
}

.tip-card {
    text-align: center;
    padding: 1rem;
}

.getting-started-tips {
    background: rgba(255,215,0,0.05);
    padding: 2rem;
    border-radius: 10px;
    border: 1px solid rgba(255,215,0,0.2);
}

/* Available Awards Section */
.available-awards-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 1rem;
}

.available-award-item {
    text-align: center;
    padding: 1rem;
    border-radius: 8px;
    background: rgba(255,255,255,0.8);
    border: 2px solid #e9ecef;
    transition: all 0.3s ease;
}

.available-award-item.locked {
    opacity: 0.6;
    border-color: #ddd;
}

.available-award-item:not(.locked) {
    border-color: #FFD700;
    box-shadow: 0 4px 15px rgba(255,215,0,0.2);
}

.award-preview i {
    color: #FFD700;
    margin-bottom: 0.5rem;
}

.award-preview h6 {
    font-size: 0.9rem;
    margin-bottom: 0.5rem;
}

.award-preview p {
    font-size: 0.8rem;
    margin-bottom: 0.5rem;
}

.award-requirement {
    margin-top: 0.5rem;
}

/* Leaderboard */
.leaderboard-card {
    background: linear-gradient(135deg, rgba(255,215,0,0.1), rgba(0,150,57,0.1));
    border: 1px solid rgba(255,215,0,0.3);
}

.leaderboard-item {
    display: flex;
    align-items: center;
    margin-bottom: 1rem;
    padding: 0.5rem;
    background: rgba(255,255,255,0.8);
    border-radius: 8px;
}

.leaderboard-item.your-rank {
    background: rgba(255,215,0,0.2);
    border: 2px solid #FFD700;
}

.rank-badge {
    width: 35px;
    height: 35px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: bold;
    color: white;
    margin-right: 1rem;
    background: #6c757d;
}

.rank-badge.gold { background: linear-gradient(135deg, #FFD700, #FFA500); color: #000; }
.rank-badge.silver { background: linear-gradient(135deg, #C0C0C0, #A8A8A8); color: #000; }
.rank-badge.bronze { background: linear-gradient(135deg, #CD7F32, #B8860B); color: #fff; }

.pilot-info {
    flex: 1;
}

/* Timeline */
.timeline {
    position: relative;
    padding-left: 2rem;
}

.timeline::before {
    content: '';
    position: absolute;
    left: 1rem;
    top: 0;
    bottom: 0;
    width: 2px;
    background: linear-gradient(to bottom, #FFD700, #009639);
}

.timeline-item {
    position: relative;
    margin-bottom: 2rem;
    padding-left: 2rem;
}

.timeline-marker {
    position: absolute;
    left: -2rem;
    top: 0;
    width: 2rem;
    height: 2rem;
    background: #FFD700;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #000;
    border: 3px solid #fff;
    box-shadow: 0 2px 8px rgba(0,0,0,0.1);
}

.timeline-content {
    background: rgba(255,255,255,0.8);
    padding: 1rem;
    border-radius: 8px;
    border-left: 4px solid #FFD700;
}

.timeline-header {
    display: flex;
    justify-content: between;
    align-items: center;
    margin-bottom: 0.5rem;
}

.timeline-description {
    margin: 0;
    color: #666;
    font-size: 0.9rem;
}

/* Social & Challenge Cards */
.social-card, .challenge-card {
    height: 100%;
    background: linear-gradient(135deg, rgba(255,255,255,0.95), rgba(248,249,250,0.95));
    border: 1px solid rgba(255,215,0,0.3);
}

.share-buttons .btn {
    margin: 0.25rem;
}

.challenge-icon {
    height: 60px;
    display: flex;
    align-items: center;
    justify-content: center;
}

.challenge-progress .progress {
    height: 6px;
    border-radius: 10px;
}

/* Modal Styles */
.award-category-card {
    background: rgba(255,255,255,0.9);
    border: 1px solid #e9ecef;
    border-radius: 10px;
    padding: 1.5rem;
    height: 100%;
}

.category-title {
    color: #FFD700;
    font-weight: bold;
    margin-bottom: 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 2px solid rgba(255,215,0,0.3);
}

.category-awards {
    display: grid;
    gap: 0.5rem;
}

.mini-award {
    display: flex;
    align-items: center;
    padding: 0.5rem;
    background: rgba(255,215,0,0.1);
    border-radius: 6px;
    border: 1px solid rgba(255,215,0,0.3);
    transition: all 0.3s ease;
}

.mini-award.locked {
    opacity: 0.5;
    background: rgba(200,200,200,0.1);
    border-color: #ddd;
}

.mini-award i {
    color: #FFD700;
    margin-right: 0.5rem;
    width: 20px;
}

.mini-award span {
    font-size: 0.85rem;
    font-weight: 500;
}

/* Responsive adjustments */
@media (max-width: 768px) {
    .awards-header .row {
        text-align: center;
    }
    
    .pilot-rank-badge {
        margin-top: 1rem;
        display: inline-block;
    }
    
    .stat-card {
        margin-bottom: 1rem;
    }
    
    .available-awards-grid {
        grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
    }
    
    .timeline {
        padding-left: 1rem;
    }
    
    .timeline-item {
        padding-left: 1.5rem;
    }
    
    .timeline-marker {
        left: -1.5rem;
        width: 1.5rem;
        height: 1.5rem;
    }
}

/* Responsive adjustments */
@media (max-width: 768px) {
    .awards-header .row {
        text-align: center;
    }
    
    .pilot-rank-badge {
        margin-top: 1rem;
        display: inline-block;
    }
    
    .stat-card {
        margin-bottom: 1rem;
    }
}
</style>

<script>
// Award filtering functionality
document.addEventListener('DOMContentLoaded', function() {
    const filterSelect = document.getElementById('awardFilter');
    if (filterSelect) {
        filterSelect.addEventListener('change', function() {
            const filterValue = this.value;
            const awardItems = document.querySelectorAll('.award-item');
            
            awardItems.forEach(item => {
                const awardDate = new Date(item.dataset.date);
                const thirtyDaysAgo = new Date();
                thirtyDaysAgo.setDate(thirtyDaysAgo.getDate() - 30);
                
                let show = false;
                
                switch(filterValue) {
                    case 'all':
                        show = true;
                        break;
                    case 'recent':
                        show = awardDate >= thirtyDaysAgo;
                        break;
                    case 'flight':
                        show = item.innerHTML.includes('Flight') || item.innerHTML.includes('Pirep');
                        break;
                    case 'milestone':
                        show = item.innerHTML.includes('Hours') || item.innerHTML.includes('Mile');
                        break;
                }
                
                item.style.display = show ? 'block' : 'none';
            });
        });
    }
});

// Social sharing functions
function shareAchievement(platform) {
    const totalAwards = {{ $award_stats['total_awards'] }};
    const pilotName = "{{ Auth::user()->name }}";
    const airlineName = "Air Jamaica Virtual";
    
    let shareText = `🏆 ${pilotName} has earned ${totalAwards} awards flying with ${airlineName}! #VirtualAviation #Air Jamaica Virtual`;
    let shareUrl = window.location.href;
    
    switch(platform) {
        case 'twitter':
            window.open(`https://twitter.com/intent/tweet?text=${encodeURIComponent(shareText)}&url=${encodeURIComponent(shareUrl)}`);
            break;
        case 'discord':
            navigator.clipboard.writeText(`${shareText}\n${shareUrl}`).then(() => {
                alert('Achievement text copied to clipboard! You can now paste it in Discord.');
            });
            break;
    }
}

// Certificate generation
function generateCertificate() {
    const pilotName = "{{ Auth::user()->name }}";
    const totalAwards = {{ $award_stats['total_awards'] }};
    const flightHours = {{ Auth::user()->flight_time ? round(Auth::user()->flight_time / 60, 1) : 0 }};
    
    // Create a simple certificate overlay
    const certificateWindow = window.open('', '_blank', 'width=800,height=600');
    
    certificateWindow.document.write(`
        <html>
        <head>
            <title>Pilot Achievement Certificate</title>
            <style>
                body { 
                    font-family: 'Times New Roman', serif; 
                    background: linear-gradient(135deg, #FFD700, #009639);
                    margin: 0; 
                    padding: 40px;
                    display: flex;
                    justify-content: center;
                    align-items: center;
                    min-height: 100vh;
                }
                .certificate {
                    background: white;
                    padding: 40px;
                    border-radius: 20px;
                    text-align: center;
                    box-shadow: 0 10px 30px rgba(0,0,0,0.3);
                    border: 10px solid #FFD700;
                    max-width: 600px;
                    width: 100%;
                }
                .header { color: #009639; font-size: 2.5em; font-weight: bold; margin-bottom: 20px; }
                .subtitle { color: #FFD700; font-size: 1.2em; margin-bottom: 30px; }
                .pilot-name { color: #000; font-size: 2em; font-weight: bold; margin: 20px 0; }
                .achievement { color: #666; font-size: 1.1em; margin: 10px 0; }
                .signature { margin-top: 40px; color: #999; }
                .print-btn { 
                    background: #009639; 
                    color: white; 
                    border: none; 
                    padding: 10px 20px; 
                    border-radius: 5px; 
                    margin-top: 20px;
                    cursor: pointer;
                }
            </style>
        </head>
        <body>
            <div class="certificate">
                <div class="header">🏆 CERTIFICATE OF ACHIEVEMENT 🏆</div>
                <div class="subtitle">Air Jamaica Virtual Airlines</div>
                <hr style="border: 2px solid #FFD700; margin: 20px 0;">
                
                <p style="margin: 30px 0; font-size: 1.1em;">This certifies that</p>
                <div class="pilot-name">${pilotName}</div>
                <p style="margin: 30px 0; font-size: 1.1em;">has successfully achieved</p>
                
                <div class="achievement">${totalAwards} Aviation Awards</div>
                <div class="achievement">${flightHours} Flight Hours</div>
                
                <p style="margin: 40px 0; font-style: italic;">
                    In recognition of dedication, skill, and commitment to excellence in virtual aviation.
                </p>
                
                <div class="signature">
                    <p>_______________________</p>
                    <p>Chief Pilot<br>Air Jamaica Virtual Airlines</p>
                    <p style="font-size: 0.9em; margin-top: 20px;">Date: ${new Date().toLocaleDateString()}</p>
                </div>
                
                <button class="print-btn" onclick="window.print()">🖨️ Print Certificate</button>
            </div>
        </body>
        </html>
    `);
    
    certificateWindow.document.close();
}

// Challenge interaction
function joinChallenge() {
    alert('Challenge feature coming soon! Stay tuned for exciting weekly challenges.');
}

// Award preview interactions
document.addEventListener('DOMContentLoaded', function() {
    const availableAwards = document.querySelectorAll('.available-award-item');
    
    availableAwards.forEach(award => {
        award.addEventListener('click', function() {
            if (!this.classList.contains('locked')) {
                // Show earned award details
                const awardName = this.querySelector('h6').textContent;
                alert(`🎉 Congratulations! You've unlocked the "${awardName}" award!`);
            } else {
                // Show requirements for locked awards
                const requirement = this.querySelector('.award-requirement small').textContent;
                alert(`🔒 To unlock this award: ${requirement}`);
            }
        });
    });
});

// Smooth scroll to sections
function scrollToSection(sectionId) {
    document.getElementById(sectionId).scrollIntoView({ 
        behavior: 'smooth' 
    });
}

// Auto-refresh achievements (every 5 minutes)
setInterval(function() {
    // This would typically make an AJAX call to check for new awards
    console.log('Checking for new achievements...');
}, 300000);
</script>
@endsection
    </div>
</div>

