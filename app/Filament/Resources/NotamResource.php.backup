<?php

namespace App\Filament\Resources;

use App\Filament\Resources\NotamResource\Pages;
use App\Models\Notam;
use Filament\Forms;
use Filament\Forms\Form;
use Filament\Resources\Resource;
use Filament\Tables;
use Filament\Tables\Table;

class NotamResource extends Resource
{
    protected static ?string $model = Notam::class;

    protected static ?string $navigationIcon = 'heroicon-o-exclamation-triangle';

    protected static ?string $navigationLabel = 'NOTAMs';

    protected static ?string $pluralModelLabel = 'NOTAMs';

    public static function form(Form $form): Form
    {
        return $form
            ->schema([
                Forms\Components\Grid::make(2)
                    ->schema([
                        Forms\Components\TextInput::make('identifier')
                            ->required()
                            ->maxLength(20)
                            ->placeholder('A0001/24')
                            ->helperText('NOTAM identifier (e.g., A0001/24)'),
                        
                        Forms\Components\TextInput::make('icao_code')
                            ->required()
                            ->length(4)
                            ->uppercase()
                            ->placeholder('KJFK')
                            ->helperText('4-letter ICAO airport code'),
                    ]),

                Forms\Components\TextInput::make('title')
                    ->required()
                    ->maxLength(255)
                    ->columnSpanFull()
                    ->placeholder('Brief description of the NOTAM'),

                Forms\Components\Textarea::make('description')
                    ->required()
                    ->rows(4)
                    ->columnSpanFull()
                    ->placeholder('Detailed description of the NOTAM'),

                Forms\Components\Grid::make(3)
                    ->schema([
                        Forms\Components\Select::make('priority')
                            ->options([
                                'LOW' => 'Low',
                                'NORMAL' => 'Normal',
                                'HIGH' => 'High',
                                'CRITICAL' => 'Critical',
                            ])
                            ->default('NORMAL')
                            ->required(),

                        Forms\Components\Toggle::make('active')
                            ->default(true)
                            ->helperText('Whether this NOTAM is currently active'),

                        Forms\Components\Select::make('user_id')
                            ->relationship('user', 'name')
                            ->searchable()
                            ->preload()
                            ->default(auth()->id())
                            ->helperText('User who created this NOTAM'),
                    ]),

                Forms\Components\Grid::make(2)
                    ->schema([
                        Forms\Components\DateTimePicker::make('effective_from')
                            ->required()
                            ->default(now())
                            ->native(false)
                            ->helperText('When this NOTAM becomes effective'),

                        Forms\Components\DateTimePicker::make('effective_until')
                            ->nullable()
                            ->native(false)
                            ->helperText('When this NOTAM expires (leave empty for indefinite)'),
                    ]),
            ]);
    }

    public static function table(Table $table): Table
    {
        return $table
            ->columns([
                Tables\Columns\TextColumn::make('identifier')
                    ->searchable()
                    ->sortable()
                    ->copyable(),

                Tables\Columns\TextColumn::make('icao_code')
                    ->label('Airport')
                    ->searchable()
                    ->sortable()
                    ->badge()
                    ->color('info'),

                Tables\Columns\TextColumn::make('title')
                    ->searchable()
                    ->sortable()
                    ->limit(50)
                    ->wrap(),

                Tables\Columns\BadgeColumn::make('priority')
                    ->colors([
                        'secondary' => 'LOW',
                        'primary' => 'NORMAL',
                        'warning' => 'HIGH',
                        'danger' => 'CRITICAL',
                    ])
                    ->sortable(),

                Tables\Columns\IconColumn::make('active')
                    ->boolean()
                    ->sortable(),

                Tables\Columns\TextColumn::make('effective_from')
                    ->dateTime()
                    ->sortable()
                    ->since(),

                Tables\Columns\TextColumn::make('effective_until')
                    ->dateTime()
                    ->sortable()
                    ->placeholder('Indefinite')
                    ->color(fn ($record) => $record->effective_until && $record->effective_until->isPast() ? 'danger' : null),

                Tables\Columns\TextColumn::make('user.name')
                    ->label('Created by')
                    ->sortable()
                    ->placeholder('System'),

                Tables\Columns\TextColumn::make('created_at')
                    ->dateTime()
                    ->sortable()
                    ->toggleable(isToggledHiddenByDefault: true),
            ])
            ->filters([
                Tables\Filters\SelectFilter::make('icao_code')
                    ->options(function () {
                        return \App\Models\Airport::pluck('icao', 'icao')->toArray();
                    })
                    ->searchable()
                    ->multiple(),

                Tables\Filters\SelectFilter::make('priority')
                    ->options([
                        'LOW' => 'Low',
                        'NORMAL' => 'Normal',
                        'HIGH' => 'High',
                        'CRITICAL' => 'Critical',
                    ])
                    ->multiple(),

                Tables\Filters\Filter::make('active')
                    ->query(fn ($query) => $query->where('active', true))
                    ->default(),

                Tables\Filters\Filter::make('effective')
                    ->query(fn ($query) => $query->active())
                    ->label('Currently Effective'),

                Tables\Filters\Filter::make('critical')
                    ->query(fn ($query) => $query->where('priority', 'CRITICAL'))
                    ->label('Critical Only'),
            ])
            ->actions([
                Tables\Actions\ViewAction::make(),
                Tables\Actions\EditAction::make(),
                Tables\Actions\DeleteAction::make(),
            ])
            ->bulkActions([
                Tables\Actions\BulkActionGroup::make([
                    Tables\Actions\DeleteBulkAction::make(),
                    Tables\Actions\BulkAction::make('deactivate')
                        ->label('Deactivate')
                        ->icon('heroicon-o-pause')
                        ->color('warning')
                        ->action(fn ($records) => $records->each->update(['active' => false]))
                        ->requiresConfirmation(),
                ]),
            ])
            ->defaultSort('effective_from', 'desc');
    }

    public static function getPages(): array
    {
        return [
            'index' => Pages\ListNotams::route('/'),
            'create' => Pages\CreateNotam::route('/create'),
            'view' => Pages\ViewNotam::route('/{record}'),
            'edit' => Pages\EditNotam::route('/{record}/edit'),
        ];
    }

    public static function getNavigationBadge(): ?string
    {
        return static::getModel()::where('priority', 'CRITICAL')->where('active', true)->count() ?: null;
    }

    public static function getNavigationBadgeColor(): ?string
    {
        return 'danger';
    }
}